# ==============================================================================
# YouTube 24/7 Live Engine Configuration
# ==============================================================================

# Method A: Direct Stream Key (Recommended - Zero Maintenance)
# Get from YouTube Studio -> Go Live -> Stream -> Stream Key
YOUTUBE_STREAM_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_STREAM_KEY=

# Method B: Google OAuth2 & YouTube Data API (Optional - For Channel Switching)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth2callback

# Stream Engine Profiles & Settings
# Options: 720p (recommended for 1GB VPS / 7GB SSD) or 1080p
STREAM_PROFILE=720p

# Media Storage Directory
MEDIA_DIR=./media

# Playlist Behavior
# Set to 'true' to randomize video sequence on each loop cycle
SHUFFLE_PLAYLIST=false

# Auto-recovery reconnect delay in milliseconds after network disconnect
RECONNECT_DELAY_MS=3000
