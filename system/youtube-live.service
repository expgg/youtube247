[Unit]
Description=YouTube 24/7 Live Stream Broadcaster Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/youtube-247-live
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=3
StandardOutput=append:/var/www/youtube-247-live/logs/systemd.log
StandardError=append:/var/www/youtube-247-live/logs/systemd.log
Environment=NODE_ENV=production

# Security & Limits
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
